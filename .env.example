
# OBP API
OBP_URL=https://dcr.ogcr.tesobe.com
# Bank the OGCR dynamic entities live under (default: ogcr)
OBP_BANK_ID=ogcr
OBP_USERNAME=your_username
OBP_PASSWORD=your_password
OBP_CONSUMER_KEY=your_consumer_key

# Ethereum
RPC_URL=https://nkotb.openbankproject.com
PRIVATE_KEY=0xyour_private_key
# OGCR token contracts on chain 2025 (url/hash)
PARCEL_CONTRACT_ADDRESS=0x62227531b82259561CC9ad4413188F08E536598a
ACTIVITY_CONTRACT_ADDRESS=0x5034F49b27353CeDc562b49eA91C7438Ea351d36
CERTIFICATION_CONTRACT_ADDRESS=0x2e335F247E91caa168c64b63104C4475b2af3942
BATCH_CONTRACT_ADDRESS=0xe4e47451AAd6C89a6D9E4aD104A7b77FfE1D3b36
CREDIT_CONTRACT_ADDRESS=0x3f6c622D32dA3BC70730C9E677ec343cb5acFe68

# Optional
POLL_INTERVAL_SECONDS=30

# Optional: listen address for the health endpoint (GET /healthz).
# Unset disables it. The tokenizer never writes to OBP, so this is the only way
# it can report that it is alive and polling.
HEALTH_ADDR=:8081
